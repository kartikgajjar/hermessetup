#!/usr/bin/env python
"""git commit-msg hook (second layer behind guard.py): refuse an AI co-author trailer (U16)."""
import re
import sys

RX = re.compile(r"(co-authored-by:.*(claude|anthropic|copilot|chatgpt|openai|gpt|gemini|cursor|codex|devin))|"
                r"generated with \[?claude code", re.IGNORECASE)
with open(sys.argv[1], encoding="utf-8", errors="replace") as f:
    text = "".join(l for l in f if not l.startswith("#"))
if RX.search(text):
    sys.stderr.write("commit-msg: AI co-author trailers and attribution lines are not allowed (U16)\n")
    sys.exit(1)
